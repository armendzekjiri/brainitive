# Brainitive self-hosting configuration (used by compose.yaml).
# Copy to .env and fill in the values marked "change me".

APP_NAME=Brainitive
APP_ENV=production
APP_DEBUG=false
# Generate: docker compose run --rm app php artisan key:generate --show
APP_KEY=
# The URL people open, e.g. https://brainitive.example.com
APP_URL=http://localhost:8080

# Web server: ":80" serves plain HTTP (behind your own reverse proxy).
# A domain name (e.g. brainitive.example.com) makes Caddy fetch a TLS certificate itself —
# then map ports 80/443 (HTTP_PORT=80, HTTPS_PORT=443) and point DNS to this host.
SERVER_NAME=:80
HTTP_PORT=8080
HTTPS_PORT=8443
# Behind a reverse proxy (nginx, Traefik, Cloudflare): trust its forwarded headers
TRUSTED_PROXIES=*

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=brainitive
DB_USERNAME=brainitive
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Mail (invitations, notifications, password resets)
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=brainitive@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Optional: social login (see .env.example for the callback URLs)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Optional: web push — php artisan webpush:vapid prints a key pair
# VAPID_SUBJECT=mailto:admin@example.com
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
