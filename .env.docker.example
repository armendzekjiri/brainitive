# Brainitive self-hosting configuration (used by compose.yaml).
# Copy to .env and fill in the values marked "change me".

APP_NAME=Brainitive
APP_ENV=production
APP_DEBUG=false
# Leave empty: generated on the first start and kept in the storage volume.
# Or set your own: docker compose run --rm --no-deps app php artisan key:generate --show
APP_KEY=
# The URL people open, e.g. https://brainitive.example.com. Anything other than localhost must be
# https:// (production logs a warning for an http address).
APP_URL=http://localhost:8080

# Who can connect to the container's ports (compose.yaml):
# - 127.0.0.1 (default): only this machine. The local quick start, or your own HTTPS reverse proxy
#   (nginx, Caddy, Traefik…) on this host forwarding to 127.0.0.1:HTTP_PORT.
# - 0.0.0.0: everyone. Only together with a domain in SERVER_NAME (Brainitive's own HTTPS below).
#   Never plain HTTP on a public address: passwords and cookies would travel unencrypted.
BIND_ADDRESS=127.0.0.1
# Web server: ":80" serves plain HTTP (local, or behind your own reverse proxy).
# A domain name (e.g. brainitive.example.com) makes Caddy fetch a TLS certificate itself —
# then set BIND_ADDRESS=0.0.0.0, map ports 80/443 (HTTP_PORT=80, HTTPS_PORT=443) and point DNS here.
SERVER_NAME=:80
HTTP_PORT=8080
HTTPS_PORT=8443
# Only behind your own reverse proxy: the proxy's address as the container sees it, so Brainitive
# sees HTTPS and the real client IP. A proxy on this host arrives from the Docker network's gateway
# (see docs.brainitive.app/self-hosting/docker#option-b-behind-your-own-reverse-proxy), for example
# TRUSTED_PROXIES=172.18.0.1. Empty = trust no proxy: right for the local quick start and for
# Brainitive's own HTTPS. Never `*` or whole private ranges while others can reach the port.
TRUSTED_PROXIES=
# Session cookie only over HTTPS: automatic when APP_URL starts with https://.
# SESSION_SECURE_COOKIE=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# PostgreSQL, the database Brainitive is developed and tested on
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=brainitive
DB_USERNAME=brainitive
DB_PASSWORD=change-me

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Mail (invitations, notifications, password resets). "log" only writes mails to the logs,
# so sign-up works before mail is set up — switch to smtp (or set SMTP in the admin console).
MAIL_MAILER=log
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=brainitive@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Live co-editing of documents: the "realtime" service in compose.yaml. Works as is — the browser
# connects to /collab on this host and the shared secret is derived from APP_KEY.
# Turn it off: COLLAB_URL= (empty) and remove the realtime service from compose.yaml.
# COLLAB_URL=/collab
# COLLAB_SECRET=   # optional own secret instead of the APP_KEY-derived one
# Live updates (instant bell, presence, typing) use the same service; off on their own with:
# LIVE_ENABLED=false

# Instance admins are told once a new Brainitive release is out (a daily anonymous check of GitHub's
# public API; nothing is installed). Turn it off with:
# BRAINITIVE_UPDATE_CHECK=false

# Optional: social login (see .env.example for the callback URLs)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Optional: web push — php artisan webpush:vapid prints a key pair
# VAPID_SUBJECT=mailto:admin@example.com
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Optional: email → helpdesk forwarding addresses (docs/self-hosting.md "Email to helpdesk")
# INBOUND_MAIL_DOMAIN=inbound.example.com
# INBOUND_MAIL_PROVIDER=postmark
# INBOUND_MAIL_POSTMARK_TOKEN=
# INBOUND_MAIL_MAILGUN_SIGNING_KEY=

# Optional: email → helpdesk through a connected IMAP mailbox (set per helpdesk; the scheduler polls it)
# HELPDESK_MAIL_MAX_MESSAGE_MB=25
