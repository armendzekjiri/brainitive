+// Duplicate Item Dialog Component
+function DuplicateItemDialog({
+    item,
+    workspace,
+    project,
+    board,
+    open,
+    onOpenChange,
+}: {
+    item: Item | null;
+    workspace: Workspace;
+    project: Project;
+    board: Board;
+    open: boolean;
+    onOpenChange: (open: boolean) => void;
+}) {
+    if (!item) return null;
+    const hasSubtasks = (item.children_count ?? 0) > 0 || (item.children && item.children.length > 0);
+
+    const handleDuplicate = (withSubitems: boolean) => {
+        router.post(route('boards.items.duplicate', [workspace.slug, project.slug, board.slug, item.id]), {
+            with_subitems: withSubitems
+        }, {
+            onSuccess: () => onOpenChange(false),
+            preserveScroll: true
+        });
+    };
+
+    return (
+        <Dialog open={open} onOpenChange={onOpenChange}>
+            <DialogContent>
+                <DialogHeader>
+                    <DialogTitle>Duplicate Item</DialogTitle>
+                    <DialogDescription>
+                        You are about to duplicate the item <strong>{item.key}</strong>.
+                        {hasSubtasks && " This item has subtasks."}
+                    </DialogDescription>
+                </DialogHeader>
+                <div className="flex flex-col gap-3 mt-4">
+                    <Button onClick={() => handleDuplicate(false)} variant={hasSubtasks ? "outline" : "default"}>
+                        Duplicate Item {hasSubtasks && "Only"}
+                    </Button>
+                    {hasSubtasks && <Button onClick={() => handleDuplicate(true)}>Duplicate with Subtasks</Button>}
+                </div>
+            </DialogContent>
+        </Dialog>
+    );
+}
