{
  "name": "brainitive-browser-extension",
  "description": "Save pages, links, issues and screenshots to Brainitive.",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "typecheck": "tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/turndown": "^5.0.6",
    "@wxt-dev/module-react": "^1.2.2",
    "typescript": "^5.9.3",
    "wxt": "^0.21.4"
  }
}
