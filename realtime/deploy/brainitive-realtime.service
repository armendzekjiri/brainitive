# Brainitive realtime server (live co-editing of documents, BRAI-54) — systemd unit example.
# Install:   sudo cp realtime/deploy/brainitive-realtime.service /etc/systemd/system/
#            (adjust User / WorkingDirectory / COLLAB_APP_URL to the install)
#            cd /var/www/brainitive && npm --prefix realtime ci --omit=dev
#            sudo systemctl daemon-reload && sudo systemctl enable --now brainitive-realtime
# Logs:      journalctl -u brainitive-realtime -f
# Deploys:   after `git pull`, run `npm --prefix realtime ci --omit=dev` and
#            `sudo systemctl restart brainitive-realtime` (browsers reconnect by themselves).
[Unit]
Description=Brainitive realtime server (live co-editing)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/brainitive
# Its own small env file, NOT the app's .env: this process faces the internet and needs only
#   COLLAB_SECRET=<the same value as in the app's .env>   (openssl rand -hex 32)
# sudo install -m 600 -o www-data /dev/null /etc/brainitive/realtime.env, then add that line.
EnvironmentFile=/etc/brainitive/realtime.env
Environment=NODE_ENV=production
Environment=COLLAB_HOST=127.0.0.1
Environment=COLLAB_PORT=1234
# Where the server reaches the app's internal API (bearer-protected; nginx must allow ~25 MB bodies)
Environment=COLLAB_APP_URL=https://brainitive.app
# Firewall / no hairpin NAT (the server can't reach its own public IP → every live connection is
# refused with "app-unreachable" in the log): call nginx on loopback under the public name instead
# (Host header + TLS SNI = COLLAB_APP_HOST, so the certificate verifies) — BRAI-345:
#   Environment=COLLAB_APP_URL=https://127.0.0.1
#   Environment=COLLAB_APP_HOST=brainitive.app
ExecStart=/usr/bin/node realtime/src/index.js
Restart=always
RestartSec=3
# hardening: it only needs the network and its own folder
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/www/brainitive

[Install]
WantedBy=multi-user.target
