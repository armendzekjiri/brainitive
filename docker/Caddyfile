# FrankenPHP's default Caddyfile (dunglas/frankenphp:1) + hardening for uploaded files.
# public/storage → storage/app/public holds user uploads: they must never run as PHP and
# never render as a page on our origin.
{
	skip_install_trust
	{$CADDY_GLOBAL_OPTIONS}
	frankenphp {
		{$FRANKENPHP_CONFIG}
	}
}

{$CADDY_EXTRA_CONFIG}

{$SERVER_NAME:localhost} {
	root {$SERVER_ROOT:public/}
	@compressible not path /.well-known/mercure
	encode @compressible zstd br gzip

	# Never execute uploads, whatever their name.
	@uploadedCode path_regexp uploadedCode (?i)^/storage/.*\.(php\d?|phtml|pht|phps|phar|inc)(/|$)
	respond @uploadedCode 404

	# Uploads are data: no MIME sniffing; HTML / SVG / XML only in a sandbox (no scripts,
	# no access to our cookies or pages).
	@uploads path /storage/*
	header @uploads X-Content-Type-Options nosniff
	@uploadedMarkup {
		path /storage/*
		not path_regexp (?i)\.(pdf|png|jpe?g|gif|webp|avif|bmp|ico|heic|heif|tiff?|mp3|wav|ogg|oga|m4a|aac|flac|mp4|m4v|mov|webm|avi|mkv|zip|gz|tgz|7z|rar|bz2|tar|bin|docx?|xlsx?|pptx?|odt|ods|odp|csv|tsv|txt|md|json|rtf)$
	}
	header @uploadedMarkup Content-Security-Policy "default-src 'none'; img-src data:; style-src 'unsafe-inline'; sandbox"

	# Live co-editing of documents (BRAI-54): the realtime service's WebSocket on this host, so no
	# extra port. Without the service this answers 502 and the editor falls back to single-user editing.
	# Live channels (BRAI-151) use the same route (/collab?live=1). The service's publish endpoint
	# (/internal/live/publish) is deliberately NOT routed: the app reaches it on the Docker network.
	handle /collab* {
		reverse_proxy {$COLLAB_UPSTREAM:realtime:1234}
	}

	{$CADDY_SERVER_EXTRA_DIRECTIVES}
	php_server {
	}
}

# Live co-editing: the realtime service reaches Brainitive's internal API here (plain HTTP inside the
# Docker network, whatever SERVER_NAME is). compose.yaml doesn't publish this port; the API also needs
# a key derived from COLLAB_SECRET / APP_KEY.
http://:{$COLLAB_INTERNAL_PORT:8081} {
	root {$SERVER_ROOT:public/}
	@collabInternal path /api/internal/collab/*
	handle @collabInternal {
		php_server
	}
	handle {
		respond 404
	}
}

import Caddyfile.d/*.caddyfile
