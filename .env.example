APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google OAuth (optional; leave empty to hide "Continue with Google" on login)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI="${APP_URL}/login/google/callback"

# Microsoft: "Continue with Microsoft" + Outlook / Microsoft 365 calendars + Teams meetings (optional;
# leave empty to hide them). ONE Microsoft Entra app registration (multitenant + personal accounts), Web
# redirect URIs ${APP_URL}/login/microsoft/callback and ${APP_URL}/calendar/connections/outlook/callback,
# ID-token optional claims email + xms_edov. Full setup: docs/ai/tasks/feat-microsoft-login.md
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=common
# MICROSOFT_REDIRECT_URI="${APP_URL}/calendar/connections/outlook/callback"
# MICROSOFT_LOGIN_REDIRECT_URI="${APP_URL}/login/microsoft/callback"

# GitHub OAuth (optional; leave empty to hide "Continue with GitHub" on login)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI="${APP_URL}/login/github/callback"

# Web Push (browser notifications). Generate keys with: php artisan webpush:vapid
VAPID_SUBJECT=mailto:you@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Let workspace AI settings call servers on localhost / your private network (e.g. Ollama
# next to Brainitive). Off by default so users can't make the server reach internal services.
AI_ALLOW_PRIVATE_ENDPOINTS=false

# Email → helpdesk through forwarding addresses (optional; docs/self-hosting.md "Email to helpdesk").
# Each helpdesk gets <name>-<random>@INBOUND_MAIL_DOMAIN; point the domain's MX at Postmark or
# Mailgun and route its mail to https://<APP_URL>/api/inbound-mail/<provider>. Off (404) while empty.
# INBOUND_MAIL_DOMAIN=inbound.example.com
# INBOUND_MAIL_PROVIDER=postmark
# INBOUND_MAIL_POSTMARK_TOKEN=          # long random string, the password in the webhook URL
# INBOUND_MAIL_MAILGUN_SIGNING_KEY=     # Mailgun → Sending → Webhooks → HTTP webhook signing key

# Email → helpdesk through a connected IMAP mailbox (set per helpdesk in its settings; needs the scheduler).
# HELPDESK_MAIL_MAX_MESSAGE_MB=25           # larger mail is not downloaded
# HELPDESK_MAIL_ALLOW_PRIVATE_HOSTS=false   # APP_ENV=local only: local mail servers, unencrypted connections

# Live co-editing of documents (optional; docs/ai/tasks/feat-live-docs.md → "Setup"). Off while
# COLLAB_URL is empty: documents are edited one person at a time, as before.
# Dev: `npm run collab:install` once, then `npm run collab` next to `composer run dev`.
# COLLAB_URL=ws://127.0.0.1:1234       # what the browser connects to; prod e.g. wss://brainitive.example.com/collab
# COLLAB_SECRET=                       # shared with the realtime server; empty = derived from APP_KEY
# The realtime server (realtime/src/index.js) also reads: COLLAB_PORT=1234, COLLAB_HOST=127.0.0.1,
# COLLAB_APP_URL (where it reaches this app's internal API; default APP_URL).
