BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//Example//Holidays//EN
X-WR-CALNAME:US Holidays
BEGIN:VEVENT
UID:newyear
DTSTART;VALUE=DATE:20200101
RRULE:FREQ=YEARLY
SUMMARY:New Year's Day
END:VEVENT
BEGIN:VEVENT
UID:thanksgiving
DTSTART;VALUE=DATE:20201126
RRULE:FREQ=YEARLY;BYMONTH=11;BYDAY=4TH
SUMMARY:Thanksgiving
END:VEVENT
BEGIN:VEVENT
UID:memorial
DTSTART;VALUE=DATE:20200525
RRULE:FREQ=YEARLY;BYMONTH=5;BYDAY=-1MO
SUMMARY:Memorial Day
END:VEVENT
BEGIN:VEVENT
UID:school-week
DTSTART;VALUE=DATE:20261102
DTEND;VALUE=DATE:20261103
RRULE:FREQ=DAILY;COUNT=5
EXDATE;VALUE=DATE:20261104
SUMMARY:School day
END:VEVENT
BEGIN:VEVENT
UID:school-week
RECURRENCE-ID;VALUE=DATE:20261105
DTSTART;VALUE=DATE:20261105
STATUS:CANCELLED
SUMMARY:School day
END:VEVENT
BEGIN:VEVENT
UID:payday
DTSTART;VALUE=DATE:20260925
RRULE:FREQ=MONTHLY;BYDAY=-1FR;COUNT=6
SUMMARY:Payday
END:VEVENT
END:VCALENDAR
